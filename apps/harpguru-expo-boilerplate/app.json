{
  "expo": {
    "name": "Harp Guru",
    "slug": "harp-guru",
    "platforms": ["ios", "android", "web"],
    "version": "18.5.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.jslog.harpguru",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:harpguru.com"
      ]
    },
    "android": {
      "package": "com.jslog.harpguru",
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "harpguru.com",
              "path": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "74089c1e-e0a1-4351-877a-9dc3bd837b01"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#efcded"
        }
      ]
    ]
  }
}
