{
  "name": "harpguru-expo-boilerplate",
  "version": "9.0.0",
  "description": "An expo based boilerplate to run the harpguru-core app",
  "main": "index.ts",
  "scripts": {
    "tunnel": "npx expo start --tunnel",
    "build-android": "npx eas-cli build -p android --profile production",
    "THE_FOLLOWING_WERE_JUST_AUTO_CREATED": "echo 'not a real script'",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "harpguru-core": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.4",
    "typescript": "~5.9.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
